    <% @tram_arrival_times.each do |tram| %>
      <% if tram[:arrival_time] > Time.now.getlocal %>
          <div class="matched-tram">
            <div class="departure">
              <div class="flex">
                <p class="time-to-departure">in<br>
                  <span class="time"><%= ((tram[:arrival_time] - Time.now) / 60.0).ceil %></span> mins
                </p>
                <p><%= tram[:route_number] %></p>
                <p class="departure-time"
                  data-departure-time="<%= tram[:arrival_time] %>"
                  <span class="time">
                    <%= tram[:arrival_time].strftime("%l:%M %p")  %>
                  </span>
                </p>
              </div>
            </div>
            <div class="arrival">
              <p class="arrival-time"
                data-arrival-time="<%= tram[:arrival_time] + 6*60 %>"
